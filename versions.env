# Pinned versions. These mirror the kind-kgw-demo cluster this repo was exported from.
# demo.sh sources this file; change a value here to bump it everywhere.

CLUSTER_NAME="${CLUSTER_NAME:-kgw-demo}"

# Tooling
KIND_VERSION=v0.32.0
KIND_NODE_IMAGE=kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5
KUBECTL_MIN_VERSION=v1.34.0
HELM_MIN_VERSION=v4.0.0

# Gateway API CRDs (standard channel)
GATEWAY_API_VERSION=v1.7.0

# kgateway (OCI Helm charts)
KGATEWAY_VERSION=v2.5.1
KGATEWAY_CHART_REPO=oci://cr.kgateway.dev/kgateway-dev/charts

# Snellius UI (OCI Helm chart)
SNELLIUS_VERSION=0.5.1
SNELLIUS_CHART=oci://ghcr.io/duncandoyle/charts/snellius

# Local ports used by `./demo.sh ui` and `./demo.sh verify` (override via env, e.g. GATEWAY_PORT=18080)
EXPLORER_PORT="${EXPLORER_PORT:-8099}"
SNELLIUS_PORT="${SNELLIUS_PORT:-8098}"
GATEWAY_PORT="${GATEWAY_PORT:-8080}"

# Namespaces whose user-created objects are exported into manifests/
DEMO_NAMESPACES="broken httpbin team-a team-b kgateway-system snellius"
